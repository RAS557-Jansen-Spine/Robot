                    <geom type="box" size="0.025 0.015 0.00015" rgba="1 1 0 1" pos="0.025 0 0"/>
                    <site name="motor_connector_1_site" pos="0.05 0 0" size="0.0015" rgba="0 1 1 1"/>
                    <site name="motor_connector_3_site" pos="0.05 -0.015 0.00015" size="0.0015" rgba="0 1 1 1"/>
