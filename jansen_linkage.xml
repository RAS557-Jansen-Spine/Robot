<mujoco model="jansen_linkage">
    <compiler angle="degree" />
    <option timestep="0.002" gravity="0 0 -9.81" />

    <visual>
        <global azimuth="90" elevation="-45" />
    </visual>

    <asset>
        <material name="red" rgba="1 0 0 1" />
        <material name="blue" rgba="0 0 1 1" />
        <material name="green" rgba="0 1 0 1" />
        <material name="gray" rgba="0.5 0.5 0.5 1" />
    </asset>

    <worldbody>
        <!-- Fixed base with two anchor points -->
        <body name="base" pos="0 0 0">
            <geom type="box" size="0.12 0.05 0.02" material="gray" />

            <!-- Anchor D (right side) -->
            <body name="anchor_d" pos="0.401 0 0">
                <geom type="sphere" size="0.008" material="gray" />
            </body>

            <!-- Crank center (A) -->
            <body name="crank_center" pos="0 0 0.02">
                <body name="crank" pos="0 0 0">
                    <joint name="crank_joint" type="hinge" axis="0 1 0" />
                    <geom name="crank_geom" type="capsule" fromto="0 0 0 0.38 0 0" size="0.004" material="red" />

                    <!-- Rod b: B to C -->
                    <body name="point_b" pos="0.38 0 0">
                        <joint name="joint_b" type="hinge" axis="0 1 0" />
                        <geom type="capsule" fromto="0 0 0 0.415 0 0" size="0.004" material="blue" />

                        <!-- Rod c: C to foot (F) -->
                        <body name="point_c" pos="0.415 0 0">
                            <joint name="joint_c" type="hinge" axis="0 1 0" />
                            <geom type="capsule" fromto="0 0 0 0.394 0 0" size="0.004" material="green" />

                            <!-- Foot marker -->
                            <body name="foot" pos="0.394 0 0">
                                <geom name="foot_marker" type="sphere" size="0.01" material="red" />
                            </body>
                        </body>
                    </body>
                </body>
            </body>

            <!-- Rod e: D to E -->
            <body name="rod_e" pos="0.401 0 0.02">
                <joint name="joint_e" type="hinge" axis="0 1 0" />
                <geom type="capsule" fromto="0 0 0 0.558 0 0" size="0.004" material="blue" />

                <!-- Rod f: E to junction with h -->
                <body name="junction_eh" pos="0.558 0 0">
                    <joint name="joint_f" type="hinge" axis="0 1 0" />
                    <geom type="capsule" fromto="0 0 0 0.393 0 0" size="0.004" material="green" />
                    <geom name="joint_marker" type="sphere" size="0.006" material="gray" />
                </body>
            </body>

            <!-- Rod g: vertical support -->
            <body name="anchor_g" pos="0 -0.2 0.02">
                <joint name="joint_g" type="hinge" axis="0 1 0" />
                <geom type="capsule" fromto="0 0 0 0.367 0 0" size="0.004" material="blue" />

                <!-- Rod h: connects g to junction with f -->
                <body name="junction_gh" pos="0.367 0 0">
                    <joint name="joint_h" type="hinge" axis="0 1 0" />
                    <geom type="capsule" fromto="0 0 0 0.657 0 0" size="0.004" material="green" />
                </body>
            </body>

            <!-- Rod i: back support -->
            <body name="anchor_i" pos="-0.1 0 0.02">
                <joint name="joint_i" type="hinge" axis="0 1 0" />
                <geom type="capsule" fromto="0 0 0 0.49 0 0" size="0.004" material="blue" />

                <!-- Rod j: connects i to junction with h -->
                <body name="junction_ij" pos="0.49 0 0">
                    <joint name="joint_j" type="hinge" axis="0 1 0" />
                    <geom type="capsule" fromto="0 0 0 0.50 0 0" size="0.004" material="green" />
                </body>
            </body>
        </body>

        <!-- Floor -->
        <geom name="floor" type="plane" pos="0 0 -0.1" size="2 2 0.1" material="gray" />
    </worldbody>

    <actuator>
        <velocity name="crank_motor" joint="crank_joint" kv="15" />
    </actuator>
</mujoco>